# Public (browser-safe). NEXT_PUBLIC_SUPABASE_ANON_KEY is an accepted alias.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<supabase-publishable-key>"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"

# Server only. Keep this value out of the browser bundle and logs.
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"

# Runtime: Supabase pooler connection used by the Prisma PostgreSQL adapter.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI: direct Supabase PostgreSQL connection used only for migrations.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Google Gemini API for AI book data extraction
GEMINI_API_KEY="<your-gemini-api-key>"

# Authorization: comma-separated, normalized e-mail addresses.
ADMIN_EMAILS="samorzad@example.edu.pl"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Public application URL is resolved from the current request origin.
# Leave empty when using request headers and relative URLs.
NEXT_PUBLIC_SITE_URL=""
